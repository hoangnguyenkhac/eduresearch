# ===========================================
# EduResearch Backend Environment Variables
# ===========================================

# Môi trường: development | production
NODE_ENV=production

# ===========================================
# DATABASE (Supabase PostgreSQL)
# ===========================================
# Connection string từ Supabase → Settings → Database → Connection string
# Sử dụng Session Pooler (port 6543) cho Render/serverless
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ===========================================
# SUPABASE STORAGE (File Uploads)
# ===========================================
# Settings → API → Project URL
SUPABASE_URL=https://<ref>.supabase.co
# Settings → API → service_role key (secret, không dùng anon key!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Bucket name (tạo bucket 'documents' trên Supabase Storage, set Private)
SUPABASE_STORAGE_BUCKET=documents

# ===========================================
# AUTH & SECURITY
# ===========================================
# JWT Secret - BẮT BUỘC trên production, tối thiểu 32 ký tự base64
# Tạo: openssl rand -base64 48
JWT_SECRET=your_super_secret_key_here_at_least_32_characters
# Thời hạn Access Token
JWT_EXPIRES_IN=2h
# Mật khẩu khởi tạo Admin (đổi ngay sau lần đăng nhập đầu)
ADMIN_INITIAL_PASSWORD=YourStrongInitialPassword123!
# API Base URL (dùng cho Swagger docs & link reset password)
API_BASE_URL=https://eduresearch-api.onrender.com
# Frontend URLs cho CORS (cách nhau bằng dấu phẩy)
FRONTEND_URL=https://your-app.vercel.app,https://eduresearch.share4happy.com

# ===========================================
# SERVER
# ===========================================
PORT=5000

# ===========================================
# OPTIONAL: PG Pool tuning
# ===========================================
# PG_POOL_MAX=10

# ===========================================
# LƯU Ý TRIỂN KHAI RENDER (M1 - Persistent Disk)
# ===========================================
# Nếu dùng SQLite local (không có DATABASE_URL):
#   - Thêm Persistent Disk trên Render, mount /var/data
#   - Set env: DATA_DIR=/var/data
#   - SQLite DB & uploads sẽ lưu ở /var/data (không mất khi restart)
#
# Nếu dùng Supabase (có DATABASE_URL):
#   - Không cần Persistent Disk cho DB/Uploads
#   - Chỉ cần set các biến Supabase ở trên
#   - Render Free tier vẫn chạy được