# Môi trường chạy: development | production
NODE_ENV=production

# JWT Secret - đặt chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=your_super_secret_key_here_change_this

# Allowed frontend origins (dùng cho CORS) — nhiều domain cách nhau bằng dấu phẩy
FRONTEND_URL=https://your-app.vercel.app,https://eduresearch.share4happy.com

# Port server
PORT=5000
