# Môi trường chạy: development | production
NODE_ENV=production

# JWT Secret - đặt chuỗi ngẫu nhiên dài ít nhất 32 ký tự (BẮT BUỘC TRÊN PRODUCTION)
JWT_SECRET=your_super_secret_key_here_at_least_32_characters

# Thời hạn sống của Access Token (ví dụ: 2h, 4h, 1d)
JWT_EXPIRES_IN=2h

# Mật khẩu khởi tạo ban đầu cho tài khoản Admin (tùy chọn, khuyến nghị đặt mạnh)
ADMIN_INITIAL_PASSWORD=YourStrongInitialPassword123!

# URL công khai của Backend API (dùng cho Swagger và tạo link khôi phục mật khẩu)
API_BASE_URL=https://eduresearch-api.onrender.com

# Allowed frontend origins (dùng cho CORS) — nhiều domain cách nhau bằng dấu phẩy
FRONTEND_URL=https://your-app.vercel.app,https://eduresearch.share4happy.com

# Cổng khởi chạy máy chủ
PORT=5000

# LƯU Ý KHI TRIỂN KHAI CLOUD (Render, Fly.io, Railway - M1):
# 1. Với SQLite và Uploads, hãy gắn Persistent Disk (ví dụ mount /data) để tránh mất dữ liệu khi restart container.
# 2. Hoặc cấu hình biến môi trường kết nối cơ sở dữ liệu chuyên dụng bên ngoài.
